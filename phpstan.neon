# Analysis of the package itself, inheriting the base config it ships.
#
# tests/Fixtures is excluded: it holds deliberately broken namespaces, which is
# exactly what the NamespaceCasing scanner is measured against.
includes:
    - config/phpstan.neon

parameters:
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        - tests/Fixtures

    ignoreErrors:
        # Pest builds arch()/expect() at runtime; neither `expect()` on a
        # TestCall nor `->not` on an Expectation is statically visible.
        -
            identifier: method.notFound
            path: src/Arch.php
        -
            identifier: property.notFound
            path: tests/*
